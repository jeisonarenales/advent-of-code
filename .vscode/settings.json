{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
    },
    "editor.acceptSuggestionOnEnter": "off",
    "github.copilot.enable": {
        "*": false
    }
}
